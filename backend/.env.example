# Copy to backend/.env for local runs. Leave everything unset for the classic
# single-user desktop setup (local SQLite file, no sign-in).

# Shared Supabase database (Supabase → Connect → Transaction pooler, port 6543)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase sign-in (Project Settings → API Keys). The backend also reads the VITE_ names.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI insights (optional)
# ANTHROPIC_API_KEY=sk-ant-...
